# Copy to backend/.env and fill in. Real environment variables override these.
# Demand assistant: without a key the built-in rule-based parser is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional
# COFORCE_JWT_SECRET=change-me-to-a-long-random-string
# COFORCE_AS_OF=2026-11-25        # set to empty to use the real date
# COFORCE_USE_LANGGRAPH=1         # 0 = use the built-in graph runner even if langgraph is installed
# COFORCE_NIGHTLY_AT=02:00        # daily maintenance time (local), or "off"
# COFORCE_LOG_LEVEL=INFO
